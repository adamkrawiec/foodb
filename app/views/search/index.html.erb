<div class="row">
  <div class="col-sm-12">
    <div class="search-form mb-3">
      <h3>Search for recipies</h3>
      <%= form_with url: '/search', method: :get do |form| %>
        <%= form.search_field :search %>
        <%= form.submit "Search" %>
      <% end %>
    </div>

    <div class="search-results-list">
      <% if @meals.any? %>
        <ul class="list-unstyled">
          <% @meals.each do |meal| %>
            <li class="mb-2">
              <h4><%= meal.name %></h4>
              <p>
                <%= meal.description %>
              </p>
              <% unless @bookmarks.find { _1.meal_id == meal.id } %>
                <button
                  data-controller="bookmark"
                  data-action="click->bookmark#bookmark"
                  data-meal-id="<%= meal.id %>"
                  class="bookmark-button"
                >
                  Add to favourites
                </button>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No recipes found</p>
      <% end %>
    </div>
  </div>
</div>